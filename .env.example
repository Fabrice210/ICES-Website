# Lien avec Incub-OS, la plateforme d'incubation d'ICES (page /incubation).
# Adresse de l'API Incub-OS, sans le chemin /api/v1 (ex. https://api.incubos.example).
# Le serveur Incub-OS doit autoriser le domaine de ce site dans CORS_ORIGINS.
VITE_INCUBOS_API_URL=
# Adresse de la vitrine publique d'Incub-OS, où le candidat dépose son dossier
# (bouton « Candidater » : <adresse>/candidater/<cohorte>).
VITE_INCUBOS_SITE_URL=
