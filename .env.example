# Formulaires (docs/02-trd.md, docs/mise-en-service-formulaires.md).
# Les valeurs réelles se saisissent dans Vercel (Settings → Environment Variables), jamais dans le dépôt.

# Navigateur : adresse de la fonction d'envoi (par défaut /api/demande).
VITE_FORMS_ENDPOINT=/api/demande

# Serveur (fonction api/demande.js) uniquement.
RESEND_API_KEY=
FORMS_FROM=
FORMS_TO=
